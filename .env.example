# Amarok remote MCP (research + unsigned execution quotes).
AMAROK_MCP_URL=https://amarok-mcp.compx.io/mcp
# Daily x402 spend cap in micro-USDC (5_000_000 = 5 USDC).
MAX_DAILY_X402_BASE_UNITS=5000000

# Wallet + chain (custody stays in this bot; never sent to Amarok).
# Import the same mnemonic into zs-proxy for ZeroSignal inference.
ALPHA_WALLET_MNEMONIC=
ALPHA_WALLET_ADDRESS=
ALPHA_ALGOD_SERVER=https://mainnet-api.4160.nodely.io
ALPHA_INDEXER_SERVER=https://mainnet-idx.4160.nodely.io
ALGORAND_TOKEN=
ALPHA_MATCHER_APP_ID=3078581851
ALPHA_USDC_ASSET_ID=31566704
# Still needed for Alpha SDK venue-ops Amarok does not expose yet
# (wallet open-order sync). Not used for Amarok research / place.
ALPHA_API_KEY=

# Live gates
ALPHA_ENABLE_LIVE_TRADING=true
ALPHA_CONFIRM_RISK=true

# ZeroSignal via zs-proxy (OpenAI-compatible). No provider fallback.
# Local: install zs-proxy, import ALPHA_WALLET_MNEMONIC, then:
#   zs-proxy fund --wait && zs-proxy proxy start --config config/zs-proxy.yaml
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# OPEN_AI_API_KEY=zerosignal
# OPENAI_MODEL=glm-5.2
# OPENAI_REASONING_EFFORT=medium
# AI_MODE=full
#   full — LLM calls Amarok research tools in a multi-turn loop (default)
#   lite — host prefetches research; single decide-only LLM call (lower ZeroSignal spend)
# AI_MAX_TOOL_CALLS=16
# Optional proxy spend overrides (defaults also in config/zs-proxy.yaml):
# PROXY_ZS_PRIVACY=false
# PROXY_SPEND_DAILY_CAP_USDC=5
# PROXY_SPEND_PER_REQUEST_CAP_USDC=1
# Note: zs-proxy listens on 127.0.0.1:8080 by default — keep ALPHA_HEALTH_PORT distinct.

# Required for Alpha bot state persistence.
DATABASE_URL=postgresql://postgres.example:[YOUR-PASSWORD]@aws-1-eu-north-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=1
DATABASE_CLOSE_TIMEOUT_SECONDS=1
ALPHA_STATE_KEY=alpha

# Cron runner settings for cloud worker deployment.
ALPHA_CRON_SCHEDULE=*/2 * * * *
ALPHA_CRON_COMMAND=npm run alpha:live
# DigitalOcean Web Services set PORT automatically for readiness probes.
# Set ALPHA_HEALTH_PORT locally only if you want to test the health server.
ALPHA_HEALTH_PORT=8788
# DEBUG_MODE=true enables startup and scan diagnostic logs.
DEBUG_MODE=false
ALPHA_MARKET_STATUS_PERSISTENCE=false
ALPHA_ORDERBOOK_FETCH_CONCURRENCY=12
# Set to 0 to scan all currently-active markets.
ALPHA_MAX_MARKETS_PER_SCAN=0

# Strategy / risk / lanes
ALPHA_ENABLE_REWARD_LANE=true
ALPHA_ENABLE_SPREAD_LANE=true
ALPHA_ENABLE_PARITY_LANE=false
ALPHA_TARGET_QUOTE_SIZE_USD=3
ALPHA_MAX_ORDER_SIZE_USD=3
ALPHA_MAX_MARKET_EXPOSURE_USD=6
ALPHA_MAX_TOTAL_EXPOSURE_USD=12
ALPHA_MAX_LIVE_OPEN_ORDERS=6
ALPHA_MAX_LIVE_ORDERS_PER_MARKET=2
ALPHA_LIVE_BID_USDC_BUFFER_BPS=750
ALPHA_REWARD_TARGET_QUOTE_SIZE_USD=25
ALPHA_REWARD_MIN_ORDER_SIZE_USD=20
ALPHA_REWARD_MAX_ORDER_SIZE_USD=30
ALPHA_REWARD_MAX_MARKET_EXPOSURE_USD=30
ALPHA_REWARD_MAX_TOTAL_EXPOSURE_USD=180
ALPHA_REWARD_MAX_LIVE_OPEN_ORDERS=8
ALPHA_REWARD_MAX_LIVE_ORDERS_PER_MARKET=2
ALPHA_REWARD_REQUIRE_REAL_DAILY=true
# Keep expensive actual-reward transfer-history scans out of live ticks.
# Run `npm run alpha:capital-report` to refresh actual received rewards.
ALPHA_ACTUAL_REWARD_REFRESH_IN_LIVE=false
ALPHA_QUOTE_REFRESH_THRESHOLD_CENTS=1
ALPHA_MIN_ALGO_BALANCE=3
ALPHA_REWARD_MIN_DWELL_SECONDS=180
ALPHA_ENABLE_PARITY_ARB=false
ALPHA_PARITY_MIN_TRADE_USD=1
ALPHA_PARITY_MIN_EDGE_BPS=150
ALPHA_PARITY_MAX_TRADE_USD=1
ALPHA_PARITY_MAX_DAILY_USD=3
ALPHA_PARITY_QUEUE_LIMIT=3
ALPHA_PARITY_SLOT_RESERVE=0
ALPHA_PARITY_SLIPPAGE_CENTS=0.25
ALPHA_PARITY_MIN_DEPTH_USD=1
ALPHA_PARITY_REQUIRE_IMMEDIATE_MERGE=true
ALPHA_ENABLE_SPREAD_CAPTURE=true
ALPHA_SPREAD_SCAN_ORDERBOOK_LIMIT=75
ALPHA_SPREAD_TARGET_ORDER_SIZE_USD=2
ALPHA_SPREAD_ORDER_SIZE_USD=2
ALPHA_SPREAD_MIN_ORDER_SIZE_USD=1
ALPHA_SPREAD_MAX_ORDER_SIZE_USD=3
ALPHA_MIN_SPREAD_CAPTURE_CENTS=1
ALPHA_MIN_SPREAD_VOLUME_USD=1
ALPHA_MIN_SPREAD_DEPTH_USD=0.25
ALPHA_SPREAD_PERSISTENCE_SCANS=2
ALPHA_SPREAD_EXIT_SLOT_RESERVE=2
ALPHA_MIN_SPREAD_ENTRY_MIDPOINT=0.05
ALPHA_MIN_SPREAD_EXIT_MIDPOINT=0.01
ALPHA_SPREAD_ENTRY_MIN_DWELL_SECONDS=600
ALPHA_SPREAD_EXIT_EDGE_CENTS=1
ALPHA_SPREAD_EXIT_MIN_DWELL_SECONDS=1800
ALPHA_MAX_SPREAD_MIDPOINT=0.97
ALPHA_SPREAD_MAX_MARKET_EXPOSURE_USD=6
ALPHA_SPREAD_MAX_TOTAL_EXPOSURE_USD=30
ALPHA_SPREAD_MAX_LIVE_OPEN_ORDERS=4
ALPHA_SPREAD_MAX_LIVE_ORDERS_PER_MARKET=2
ALPHA_MAX_SPREAD_MARKET_EXPOSURE_USD=2

# Inventory unwind (independent of spread-entry order caps).
ALPHA_UNDERWATER_EXIT_ENABLED=true
ALPHA_UNDERWATER_EXIT_MIN_AGE_HOURS=24
ALPHA_UNDERWATER_EXIT_MAX_LOSS_CENTS=15
ALPHA_UNDERWATER_EXIT_MAX_NOTIONAL_USD=5
ALPHA_UNDERWATER_EXIT_MAX_MARKET_LOSS_USD=5
ALPHA_STALE_INVENTORY_AGE_HOURS=72
ALPHA_STALE_INVENTORY_MAX_LOSS_CENTS=50
ALPHA_INVENTORY_EXIT_MAX_NOTIONAL_USD=60
ALPHA_INVENTORY_EXIT_FULL_POSITION=true
ALPHA_ENABLE_INVENTORY_MERGE=true
ALPHA_INVENTORY_MERGE_MIN_SHARES=1
ALPHA_ENABLE_RESOLVED_CLAIM=true
ALPHA_MAX_INVENTORY_NOTIONAL_USD=40

# Telegram notifications (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DISABLE_NOTIFICATIONS=false
ALPHA_TELEGRAM_SKIP_NOTICE_MINUTES=30
# Optional fixed UTC hour for the once-per-day summary (0-23).
ALPHA_TELEGRAM_DAILY_SUMMARY_HOUR=
